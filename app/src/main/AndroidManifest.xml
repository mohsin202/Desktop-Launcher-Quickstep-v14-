<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 7-10 have no "all files" permission: the ordinary storage permission is used there -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Special accesses turned on by the user in Settings > Permissions (system screens). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Special permission, given once with adb (see Settings > Windows): lets the launcher switch on the system's freeform
         window support, like the Taskbar app does. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Only granted when the launcher is installed as a system (priv-app) app, e.g. in BassOS; ignored otherwise. They let the taskbar read
         the system's own task list (the Recents list), remove tasks and move a task into a freeform window. -->
    <uses-permission android:name="android.permission.REAL_GET_TASKS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REMOVE_TASKS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.START_TASKS_FROM_RECENTS"
        tools:ignore="ProtectedPermissions" />

    <!-- Quickstep: the same signature/privileged permissions the stock launcher3 gets from
         /system_ext/etc/permissions/com.android.launcher3.xml (see rom/com.android.launcher3.xml). -->
    <uses-permission android:name="android.permission.STATUS_BAR" tools:ignore="ProtectedPermissions" />
    <!-- Signature permissions: needed for the navigation-bar window (TYPE_NAVIGATION_BAR_PANEL + provided insets). Without them
         the taskbar falls back to the accessibility overlay automatically. -->
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.STATUS_BAR_SERVICE" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.STOP_APP_SWITCHES" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ALLOW_SLIPPERY_TOUCHES" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.CONTROL_REMOTE_APP_TRANSITION_ANIMATIONS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.BROADCAST_CLOSE_SYSTEM_DIALOGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.BIND_APPWIDGET" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS_PRIVILEGED" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_SHORTCUTS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_FRAME_BUFFER" tools:ignore="ProtectedPermissions" />
    <!-- Only granted to apps signed with the system key; lets the taskbar ask SurfaceFlinger for the brightness behind the status bar like Trebuchet. -->
    <uses-permission android:name="android.permission.ACCESS_SURFACE_FLINGER" />
    <!-- Also signature-only: asked for so we can see whether this ROM hands them to us (full-screen edge gestures, key/mouse events). -->
    <uses-permission android:name="android.permission.MONITOR_INPUT" />
    <uses-permission android:name="android.permission.INJECT_EVENTS" />
    <uses-permission android:name="android.permission.MANAGE_ACCESSIBILITY" tools:ignore="ProtectedPermissions" />

    <application
        android:persistent="true"
        android:name=".App"
        android:allowBackup="true"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Desktop">

        <activity
            android:name=".LauncherActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The Overview (Recents) screen: the component the ROM names in config_recentsComponentName -->
        <activity
            android:name="com.android.quickstep.RecentsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:taskAffinity="com.android.launcher3.recents"
            android:theme="@style/Theme.Desktop.Floating" />

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="Desktop Launcher Settings"
            android:taskAffinity="com.android.launcher3.settings"
            android:theme="@style/Theme.Desktop.Settings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WidgetEditActivity"
            android:exported="false"
            android:theme="@style/Theme.Desktop.Settings" />

        <activity
            android:name=".FreeformHackActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.android.launcher3.freeformhack"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Desktop.Hidden" />

        <!-- SystemUI binds this service (config_recentsComponentName = com.android.launcher3/...RecentsActivity) and
             hands over the ISystemUiProxy. Only SystemUI may bind it (STATUS_BAR_SERVICE). -->
        <receiver android:name=".AllAppsReceiver" android:exported="false" />

        <service
            android:name=".TouchInteractionService"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.STATUS_BAR_SERVICE">
            <intent-filter>
                <action android:name="android.intent.action.QUICKSTEP_SERVICE" />
            </intent-filter>
        </service>

        <service
            android:name=".NotifService"
            android:exported="true"
            android:label="Desktop Launcher notification dots"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <provider
            android:name=".DesktopProvider"
            android:authorities="com.android.launcher3.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
